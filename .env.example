# Local MongoDB replica set
MONGODB_URI=mongodb://127.0.0.1:27017/next-shop-fullstack-db?replicaSet=rs0

# Generate a random secret with at least 32 characters.
# Example (PowerShell): node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters
